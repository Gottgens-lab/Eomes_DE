## Dimensionality reduction ##
##############################

rule dimensionality_reduction: 
    input:
        rules.peak_calling.output, # this is not necessary, it's just to make sure that dimred is executed after the PeakMatrix is obtained
        script = config["scripts"]["dimensionality_reduction_cells"],
        custom_peakset = rules.add_custom_peakset.output,
        metadata = rules.qc_archr.output.metadata
    output:
        #umap = config["directories"]["results"]+"/dimensionality_reduction/cells/umap_{dimred_matrix}_nfeatures{dimred_nfeatures}_ndims{dimred_ndims}.txt.gz",
        #lsi = config["directories"]["results"]+"/dimensionality_reduction/lsi_{dimred_matrix}_nfeatures{dimred_nfeatures}_ndims{dimred_ndims}.txt.gz",
         lsi = config["directories"]["results"]+"/dimensionality_reduction/cells/{matrix}/remove_ExE_cells_{remove_ExE_cells}/batch_correction_{batch_variable}/lsi_nfeatures{nfeatures}_dims{ndims}.txt.gz"
    params:
        seed = 42,
        matrix = config["dimensionality_reduction"]["matrix"],
        remove_ExE_cells = config["dimensionality_reduction"]["remove_ExE_cells"],
        nfeatures = config["dimensionality_reduction"]["nfeatures"],
        ndims = config["dimensionality_reduction"]["ndims"],
        batch_variable = config["dimensionality_reduction"]["batch_variable"],
        batch_method = config["dimensionality_reduction"]["batch_method"],
        n_neighbors = config["dimensionality_reduction"]["n_neighbors"],
        min_dist = config["dimensionality_reduction"]["min_dist"], 
        colour_by = config["dimensionality_reduction"]["colour_by"],
        outdir = config["directories"]["results"] + "/dimensionality_reduction/cells"
    threads: 
        config["slurm"]["dimensionality_reduction"]["threads"]
    resources:
        mem_mb = config["slurm"]["dimensionality_reduction"]["memory"]
    log: 
        "logs/umap_{matrix}_remove_ExE_cells_{remove_ExE_cells}_batch_correction_{batch_variable}_umap_nfeatures{nfeatures}_dims{ndims}.log"
    shell:
        "Rscript {input.script} --metadata {input.metadata} --matrix {wildcards.matrix} --remove_ExE_cells {wildcards.remove_ExE_cells} --nfeatures {wildcards.nfeatures} --ndims {wildcards.ndims} \
            --batch_variable {wildcards.batch_variable} --batch_method {params.batch_method} \
            --n_neighbors {params.n_neighbors} --min_dist {params.min_dist} --colour_by {params.colour_by} \
            --seed {params.seed} --outdir {params.outdir} > {log}"

#########################
## Link peaks to genes ##
#########################

rule link_peaks_to_genes:
    input:
        script = config["scripts"]["link_peaks_to_genes"],
        gene_metadata = config["resources"]["gene_metadata"],
        peak_metadata = rules.peak_calling.output.peak_metadata,
        order = expand(config["directories"]["results"]+"/dimensionality_reduction/cells/{matrix}/remove_ExE_cells_{remove_ExE_cells}/batch_correction_{batch_variable}/lsi_nfeatures{nfeatures}_dims{ndims}.txt.gz",
            matrix = config["dimensionality_reduction"]["matrix"],
            remove_ExE_cells = config["dimensionality_reduction"]["remove_ExE_cells"],
            nfeatures = config["dimensionality_reduction"]["nfeatures"],
            ndims = config["dimensionality_reduction"]["ndims"],
            batch_variable = config["dimensionality_reduction"]["batch_variable"],
            batch_method = config["dimensionality_reduction"]["batch_method"]
         ) # fix order
    output:
        config["directories"]["results"] + "/peak_calling/peaks2genes/peaks2genes_all.txt.gz",
        config["directories"]["results"] + "/peak_calling/peaks2genes/peaks2genes_nearest.txt.gz"
    params:
        gene_window = config["link_peaks_to_genes"]["gene_window"],
        outdir = config["directories"]["results"] + "/peak_calling/peaks2genes"
    threads: 
        config["slurm"]["link_peaks_to_genes"]["threads"]
    resources:
        mem_mb = config["slurm"]["link_peaks_to_genes"]["memory"]
    log: 
        "logs/link_peaks_to_genes.log"
    shell:
        "Rscript {input.script} --gene_metadata {input.gene_metadata} --peak_metadata {input.peak_metadata} --gene_window {params.gene_window} --outdir {params.outdir} > {log}"

